# Copy to .env and fill in real values. .env is gitignored and must stay that way.
# Every key the application reads is listed here. Keys without a default are
# required — the app refuses to start if they are missing.

# --- Application ---------------------------------------------------------
# local | staging | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL (required) ----------------------------------------------
# Async driver is mandatory: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://raguser:CHANGE_ME@127.0.0.1:5432/ragdb
# Explicit pool sizing — see README "Deployment gaps".
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# --- ChromaDB ------------------------------------------------------------
# Directory for the persistent client. Relative paths resolve from the repo root.
CHROMA_PERSIST_DIR=data/chroma

# --- Reranker ------------------------------------------------------------
# none | local. "local" = the int8 ONNX cross-encoder in RERANKER_MODEL_DIR.
# Weights are NOT in git: run `uv run python scripts/fetch_reranker_model.py`
# once (22.8 MiB), or the app aborts at startup. It never falls back to "none" —
# answers that look reranked but are not are worse than a refusal to start.
# `app.cli evaluate` ignores this and defaults to "none" so the recorded
# benchmark gate keeps reproducing; pass --reranker local to turn it on there.
RERANKER=local
# Relative paths resolve from the repo root, not the working directory.
RERANKER_MODEL_DIR=models/reranker
RERANKER_MANIFEST_PATH=scripts/reranker_model.sha256
# ONNX Runtime intra-op threads. A pure latency knob — scores are bitwise
# identical at 1/2/4/8 because inference runs one pair at a time. 4 = physical
# cores on the dev box; lower it on a smaller host or one running other work.
RERANKER_INTRA_OP_THREADS=4

# --- LLM provider (required) --------------------------------------------
# Step 01 only checks that this is non-empty; no request is ever sent.
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=claude-sonnet-5

# --- Embedding provider (required) ---------------------------------------
# Paid API — see Step 02's approval gate. 200M-token free tier as of 2026-08.
VOYAGE_API_KEY=replace-with-your-voyage-key
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=1024

# --- docker-compose.dev.yml ---------------------------------------------
# Local-only Postgres credentials. Must match DATABASE_URL above.
POSTGRES_USER=raguser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ragdb
