# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local runtime data (Chroma persistence, uploads)
data/

# Derived data — cached query embeddings for the golden-set evaluation harness.
# Regenerated from tests/fixtures/golden_set.json on a cache miss; committing
# it would bloat the repo and rot silently on a model change.
tests/fixtures/query_embeddings.json

# Reranker weights — 22.8 MiB, fetched at build time by
# scripts/fetch_reranker_model.py and baked into the image. Never committed.
# Do NOT try to re-include the checksum manifest here with a `!` negation: git
# cannot re-include a file whose parent directory is excluded, so it would stay
# silently ignored and the drift detector would never be committed. The manifest
# lives outside this tree, at scripts/reranker_model.sha256, for that reason.
models/reranker/
